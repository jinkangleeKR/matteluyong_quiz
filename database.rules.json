{
  "rules": {
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "quizCatalog": {
      "$ownerUid": {
        ".read": "auth != null && auth.uid === $ownerUid",
        ".write": "auth != null && auth.uid === $ownerUid",
        "$quizId": {
          ".validate": "!newData.exists() || (newData.child('id').val() === $quizId && newData.child('ownerUid').val() === $ownerUid && newData.child('title').isString() && newData.child('title').val().length > 0 && newData.child('title').val().length <= 60 && newData.child('questions').hasChildren())"
        }
      }
    },
    "ownerRooms": {
      "$ownerUid": {
        ".read": "auth != null && auth.uid === $ownerUid",
        ".write": "auth != null && auth.uid === $ownerUid"
      }
    },
    "roomSecrets": {
      "$roomId": {
        ".read": "auth != null && data.child('ownerUid').val() === auth.uid",
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || (data.exists() && data.child('ownerUid').val() === auth.uid))",
        ".validate": "!newData.exists() || (newData.child('ownerUid').isString() && newData.child('answerKey').hasChildren())"
      }
    },
    "rooms": {
      "$roomId": {
        ".write": "auth != null && data.child('state').child('ownerUid').val() === auth.uid",
        "state": {
          ".read": true,
          ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || (data.exists() && data.child('ownerUid').val() === auth.uid))",
          ".validate": "!newData.exists() || (newData.hasChildren(['id', 'ownerUid', 'quizSnapshot', 'status', 'questionDurationSec', 'basePoints', 'speedPoints', 'questionCount']) && newData.child('id').val() === $roomId && newData.child('ownerUid').isString() && newData.child('quizSnapshot').child('questions').hasChildren() && newData.child('status').isString() && newData.child('questionDurationSec').isNumber() && newData.child('questionDurationSec').val() >= 5 && newData.child('questionDurationSec').val() <= 600 && newData.child('basePoints').isNumber() && newData.child('speedPoints').isNumber() && newData.child('questionCount').isNumber())"
        },
        "answers": {
          ".read": "auth != null && (root.child('rooms').child($roomId).child('state').child('ownerUid').val() === auth.uid || (root.child('rooms').child($roomId).child('state').child('resultsRevealAt').isNumber() && root.child('rooms').child($roomId).child('state').child('resultsRevealAt').val() <= now && root.child('rooms').child($roomId).child('lobby').child(auth.uid).exists()))",
          ".write": "auth != null && root.child('rooms').child($roomId).child('state').child('ownerUid').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('rooms').child($roomId).child('state').child('ownerUid').val() === auth.uid || (root.child('rooms').child($roomId).child('state').child('resultsRevealAt').isNumber() && root.child('rooms').child($roomId).child('state').child('resultsRevealAt').val() <= now))",
            "$questionIndex": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('lobby').child($uid).exists() && !root.child('rooms').child($roomId).child('kicked').child($uid).exists() && root.child('rooms').child($roomId).child('state').child('status').val() === 'live' && root.child('rooms').child($roomId).child('state').child('endsAt').isNumber() && now <= root.child('rooms').child($roomId).child('state').child('endsAt').val() && newData.hasChildren(['choice', 'playerName', 'answeredAt'])",
              ".validate": "newData.child('choice').isNumber() && newData.child('choice').val() >= 0 && newData.child('choice').val() <= 3 && newData.child('playerName').isString() && newData.child('playerName').val().length > 0 && newData.child('playerName').val().length <= 20 && newData.child('answeredAt').isNumber()"
            }
          }
        },
        "lobby": {
          ".read": "auth != null && (root.child('rooms').child($roomId).child('state').child('ownerUid').val() === auth.uid || (root.child('rooms').child($roomId).child('state').child('resultsRevealAt').isNumber() && root.child('rooms').child($roomId).child('state').child('resultsRevealAt').val() <= now && root.child('rooms').child($roomId).child('lobby').child(auth.uid).exists()))",
          ".write": "auth != null && root.child('rooms').child($roomId).child('state').child('ownerUid').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('rooms').child($roomId).child('state').child('ownerUid').val() === auth.uid || (root.child('rooms').child($roomId).child('state').child('resultsRevealAt').isNumber() && root.child('rooms').child($roomId).child('state').child('resultsRevealAt').val() <= now))",
            ".write": "(auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('state').child('status').val() === 'waiting' && !root.child('rooms').child($roomId).child('kicked').child($uid).exists()) || (auth != null && root.child('rooms').child($roomId).child('state').child('ownerUid').val() === auth.uid)",
            ".validate": "!newData.exists() || (newData.hasChildren(['name', 'joinedAt']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 20 && newData.child('joinedAt').isNumber())"
          }
        },
        "kicked": {
          ".read": "auth != null && root.child('rooms').child($roomId).child('state').child('ownerUid').val() === auth.uid",
          ".write": "auth != null && root.child('rooms').child($roomId).child('state').child('ownerUid').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('rooms').child($roomId).child('state').child('ownerUid').val() === auth.uid)"
          }
        },
        "waitingChat": {
          ".read": "auth != null && (root.child('rooms').child($roomId).child('state').child('ownerUid').val() === auth.uid || (root.child('rooms').child($roomId).child('state').child('status').val() === 'waiting' && root.child('rooms').child($roomId).child('lobby').child(auth.uid).exists() && !root.child('rooms').child($roomId).child('kicked').child(auth.uid).exists()))",
          ".write": "auth != null && root.child('rooms').child($roomId).child('state').child('ownerUid').val() === auth.uid",
          "$messageId": {
            ".write": "auth != null && !data.exists() && root.child('rooms').child($roomId).child('lobby').child(auth.uid).exists() && !root.child('rooms').child($roomId).child('kicked').child(auth.uid).exists() && root.child('rooms').child($roomId).child('state').child('status').val() === 'waiting'",
            ".validate": "newData.hasChildren(['uid', 'playerName', 'text', 'sentAt']) && newData.child('uid').val() === auth.uid && newData.child('playerName').isString() && newData.child('playerName').val().length > 0 && newData.child('playerName').val().length <= 20 && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 180 && newData.child('sentAt').isNumber()"
          }
        }
      }
    }
  }
}
